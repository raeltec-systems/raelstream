# Codespaces: GitHub's port forwarding terminates HTTPS in front of port 8080, so Caddy serves plain
# HTTP here. Same application routes as production, plus the stand-in platform's watch page.
{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	@app not path /watch/*
	header @app {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' wss://{$DOMAIN}; script-src 'self'; style-src 'self'; font-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	}

	import app-routes.caddy

	# What viewers would see: HLS from the stand-in RTMP "platform" (MediaMTX's own player page).
	handle /watch/* {
		reverse_proxy rs-test-platform:8888
	}
}
