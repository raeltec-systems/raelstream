{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' wss://{$DOMAIN}; script-src 'self'; style-src 'self'; font-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	}

	# The MediaMTX auth hook is internal only.
	respond /internal/* 404

	handle /api/* {
		reverse_proxy control:3000
	}
	handle /ws {
		reverse_proxy control:3000
	}
	handle_path /whip/* {
		reverse_proxy mediamtx:8889
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
