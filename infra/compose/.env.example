# Copy to infra/compose/.env on the server. Never commit the real file.
DOMAIN=stream.example.org
PUBLIC_ORIGIN=https://stream.example.org
WHIP_PUBLIC_BASE=https://stream.example.org/whip
PUBLIC_IP=203.0.113.10
DATABASE_URL=postgres://raelstream:CHANGE_ME@postgres:5432/raelstream
MEDIAMTX_INTERNAL_USER=supervisor
MEDIAMTX_INTERNAL_PASS=CHANGE_ME_LONG_RANDOM
# From `node dist/cli.js keys:generate` (control). The matching secret goes in secrets/seal_secret.
RS_SEAL_PUBLIC_KEY=
# Encrypts authenticator (TOTP) secrets at rest: `openssl rand -base64 32`. Keep a copy in your password
# manager; if it is lost, every account needs `user:reset-mfa`.
RS_TOTP_KEY=
